# Build trees
build/
out/
cmake-build-*/

# Third-party checkout. Pinned dependency, not vendored source: re-create with
#   git clone https://github.com/mauriaristi/otilib.git external/otilib
#   git -C external/otilib checkout de3f7fa2b1ba667dff054ad5ba1f6f41f4ba8b54
# Committing it would also import GPL-3.0 sources into this tree, which is
# exactly the decision docs/otilib_discovery_report.md asks to be made first.
#
# GPL-3.0 is ACCEPTED for the research prototype. Keeping the checkout external
# is an architectural choice, not a residual licensing question: it keeps a large
# upstream history out of this repository while the dependency stays optional and
# isolated behind include/warp_hypad/sensitivity/.
#
# The pin is ENFORCED, not merely documented: CMake compares
# `git -C external/otilib rev-parse HEAD` against WARP_HYPAD_OTILIB_PIN at
# configure time and fails hard on a mismatch. Fetch it with
# scripts/bootstrap_otilib.sh or scripts/bootstrap_otilib.ps1.
#
# A git submodule would record the same pin and is an equally valid choice; the
# external checkout plus bootstrap script was kept because it needs no submodule
# ceremony from contributors who never enable the backend.
external/otilib/

# Python
__pycache__/
*.pyc

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# NOTE: results/ is deliberately NOT ignored.
#
# The verification record -- verification_summary.json, verification_table.csv,
# verification_report.md and the figures -- is the evidence a milestone passed,
# stamped with the commit and compiler that produced it. Ignoring it would mean
# a repository that claims a milestone is complete while carrying nothing to
# show for it.


# OTIlib-disabled configuration tree.

build_nooti/
